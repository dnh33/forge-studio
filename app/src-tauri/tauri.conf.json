{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge Studio",
  "version": "0.2.0",
  "identifier": "dev.dnh33.forge-studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Forge Studio",
        "width": 1360,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Render images with the forge-render pipeline",
    "longDescription": "Compose prompt sets, dispatch the GitHub render pipeline, watch it live, preview the result and download it."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDRDQ5MDQzQUVBQkU3NjYKUldSbTU2dXVRNURVVE9YaDJoblM4Vk5BS1E5eDdjdmdlWHlHTEJ4NVRDcVg1bElhNjZObTVJbm8K",
      "endpoints": [
        "https://github.com/dnh33/forge-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
